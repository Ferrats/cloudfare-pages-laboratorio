---
import Footer from '../components/Footer.astro';
import HeuristicCard from '../components/HeuristicCard.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Quiz from '../components/Quiz.astro';
import { heuristics } from '../data/heuristics';
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Guia visual e prático das 10 heurísticas de usabilidade de Jakob Nielsen." />
    <meta name="theme-color" content="#f5f2ea" />
    <title>Heurísticas de Nielsen — Guia prático</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="noise" aria-hidden="true"></div>
    <Hero />
    <main id="conteudo">
      <Manifesto />
      <section class="heuristics-section" id="heuristicas" aria-labelledby="list-title">
        <div class="section-heading">
          <h2 id="list-title">As 10 lentes.</h2>
          <p>Compare um erro comum com uma solução melhor. Use os princípios como perguntas, não como uma checklist de aprovação.</p>
        </div>
        <div class="grid">
          {heuristics.map((heuristic, index) => <HeuristicCard number={index + 1} {...heuristic} />)}
        </div>
      </section>
      <Quiz />
    </main>
    <Footer />
  </body>
</html>
