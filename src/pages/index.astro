---
import HeuristicCard from '../components/HeuristicCard.astro';
import '../styles/global.css';

const heuristics = [
  {
    title: 'Visibilidade do status do sistema',
    description: 'A interface mantém as pessoas informadas sobre o que está acontecendo, no momento certo e com feedback claro.',
    example: 'mostre progresso durante um upload e confirme quando ele terminar.',
  },
  {
    title: 'Correspondência com o mundo real',
    description: 'A experiência fala a linguagem das pessoas e organiza informações de um jeito familiar e previsível.',
    example: 'use “carrinho” em vez de um termo técnico interno do sistema.',
  },
  {
    title: 'Controle e liberdade do usuário',
    description: 'Ações indesejadas têm uma saída clara, sem obrigar a pessoa a percorrer um processo longo.',
    example: 'ofereça desfazer após arquivar uma conversa por engano.',
  },
  {
    title: 'Consistência e padrões',
    description: 'Palavras, comportamentos e elementos visuais semelhantes significam a mesma coisa em toda a experiência.',
    example: 'mantenha o mesmo rótulo para salvar em todas as telas.',
  },
  {
    title: 'Prevenção de erros',
    description: 'Um bom design elimina situações perigosas ou pede confirmação antes de ações com consequências importantes.',
    example: 'desabilite datas indisponíveis antes que alguém tente reservá-las.',
  },
  {
    title: 'Reconhecimento em vez de memorização',
    description: 'Opções e informações importantes permanecem visíveis para reduzir o esforço de lembrar detalhes entre etapas.',
    example: 'exiba sugestões recentes em vez de exigir que a busca seja redigitada.',
  },
  {
    title: 'Flexibilidade e eficiência de uso',
    description: 'A experiência atende quem está começando e também acelera tarefas frequentes de pessoas experientes.',
    example: 'combine menus claros com atalhos de teclado opcionais.',
  },
  {
    title: 'Design estético e minimalista',
    description: 'Cada elemento compete por atenção; a interface deve priorizar apenas o que apoia a tarefa e a decisão atual.',
    example: 'remova métricas secundárias do resumo principal e deixe-as sob demanda.',
  },
  {
    title: 'Ajuda para reconhecer e corrigir erros',
    description: 'Mensagens de erro usam linguagem direta, apontam a causa e oferecem um próximo passo possível.',
    example: 'explique o formato esperado do CPF junto ao campo que precisa de correção.',
  },
  {
    title: 'Ajuda e documentação',
    description: 'Quando uma explicação é necessária, ela deve ser fácil de encontrar, objetiva e orientada à tarefa.',
    example: 'ofereça instruções curtas e contextuais perto de uma configuração avançada.',
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Um guia visual e prático para as 10 heurísticas de usabilidade de Jakob Nielsen." />
    <title>10 heurísticas de Nielsen</title>
  </head>
  <body>
    <a class="skip-link" href="#heuristicas">Pular para as heurísticas</a>
    <header class="hero" id="top">
      <nav aria-label="Navegação principal">
        <a class="brand" href="/">H/N</a>
        <a href="#sobre">Sobre</a>
      </nav>
      <div class="hero-content">
        <p class="eyebrow">Fundamentos de UX · 1994—hoje</p>
        <h1>10 heurísticas<br />de Nielsen</h1>
        <p class="intro">Princípios duradouros para encontrar problemas de usabilidade e tomar decisões de design mais claras.</p>
        <a class="cta" href="#heuristicas">Explorar princípios <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <main>
      <section class="heuristics" id="heuristicas" aria-labelledby="list-title">
        <div class="section-heading">
          <p class="eyebrow">Guia de consulta</p>
          <h2 id="list-title">Dez lentes para avaliar uma interface.</h2>
        </div>
        <div class="grid">
          {heuristics.map((heuristic, index) => <HeuristicCard number={index + 1} {...heuristic} />)}
        </div>
      </section>

      <section class="about" id="sobre" aria-labelledby="about-title">
        <p class="eyebrow">Como usar</p>
        <div>
          <h2 id="about-title">Heurísticas não são uma checklist de aprovação.</h2>
          <p>Use-as como lentes durante uma avaliação: percorra tarefas reais, registre onde a experiência quebra um princípio e priorize os achados pelo impacto para as pessoas.</p>
        </div>
      </section>
    </main>

    <footer>
      <p>Laboratório Astro + GitHub + Cloudflare Pages</p>
      <a href="#top">Voltar ao topo ↑</a>
    </footer>
  </body>
</html>
