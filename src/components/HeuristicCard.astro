---
interface Props {
  number: number;
  title: string;
  description: string;
  example: string;
}

const { number, title, description, example } = Astro.props;
const label = String(number).padStart(2, '0');
---

<article class="card">
  <p class="number" aria-hidden="true">{label}</p>
  <h2>{title}</h2>
  <p class="description">{description}</p>
  <p class="example"><strong>Na prática:</strong> {example}</p>
</article>

